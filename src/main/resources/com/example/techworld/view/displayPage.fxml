<AnchorPane fx:id="displayPage" prefHeight="800.0" prefWidth="1013.0" xmlns="http://javafx.com/javafx/null" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.techworld.controller.DisplayPageController">
